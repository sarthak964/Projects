# Local development template. Never put real credentials in this file.
ENVIRONMENT=development
OPENAI_API_KEY=
JWT_SECRET=replace-with-your-own-local-secret
DATABASE_URL=sqlite:///./trustay.db
ADMIN_PHONES=
# run_demo.py selects a separate DB/uploads/admin identity and pauses its scheduler.
SCHEDULER_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
